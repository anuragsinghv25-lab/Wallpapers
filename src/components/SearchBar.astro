---
interface Props {
  placeholder?: string;
}
const { placeholder = 'Search wallpapers, colours, moods…' } = Astro.props;
---

<!-- Needs JavaScript to filter, so it's hidden when scripts are off. -->
<form class="search js-only" role="search" onsubmit="return false">
  <label class="sr-only" for="q">Search wallpapers</label>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
  </svg>
  <input id="q" type="search" name="q" placeholder={placeholder} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-search-input />
</form>
